{
  "name": "testscribe",
  "displayName": "TestScribe",
  "description": "Run plain-English browser tests from saved cases in VS Code",
  "version": "0.1.0",
  "publisher": "testscribe",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Tchaikovsky29/TestScribe.git" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Testing"],
  "activationEvents": ["onCommand:testscribe.newCase", "onCommand:testscribe.runCase", "onView:testscribe.results"],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      { "command": "testscribe.newCase", "title": "TestScribe: New Test Case" },
      { "command": "testscribe.runCase", "title": "TestScribe: Run Test Case" },
      { "command": "testscribe.setApiKey", "title": "TestScribe: Set API Key" },
      { "command": "testscribe.openReport", "title": "TestScribe: Open Last Report" }
    ],
    "menus": {
      "editor/title": [{ "command": "testscribe.runCase", "when": "resourceExtname == .json", "group": "navigation" }],
      "explorer/context": [{ "command": "testscribe.runCase", "when": "resourceExtname == .json", "group": "navigation" }],
      "view/title": [{ "command": "testscribe.runCase", "when": "view == testscribe.results", "group": "navigation" }]
    },
    "viewsContainers": {
      "activitybar": [{ "id": "testscribe", "title": "TestScribe", "icon": "resources/icon.svg" }]
    },
    "views": { "testscribe": [{ "id": "testscribe.results", "name": "Results" }] },
    "configuration": {
      "title": "TestScribe",
      "properties": {
        "testscribe.cliPath": { "type": "string", "default": "", "description": "Path to the testscribe CLI. Leave empty to use a workspace .venv or PATH." },
        "testscribe.model": { "type": "string", "default": "qwen-3.8-27b", "description": "OpenAI-compatible model ID." },
        "testscribe.baseUrl": { "type": "string", "default": "https://bharatcode.ai/api/model/v1", "description": "OpenAI-compatible API base URL." },
        "testscribe.apiKeyEnv": { "type": "string", "default": "BHARATCODE_API_KEY", "description": "Environment variable name for the API key. Use Set API Key to store it in VS Code Secret Storage." },
        "testscribe.headed": { "type": "boolean", "default": false, "description": "Show Chromium while the test runs." }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.0"
  }
}
